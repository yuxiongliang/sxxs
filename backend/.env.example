DATABASE_URL=postgresql+asyncpg://yuxiongliang@127.0.0.1:5433/ant_design_pro_admin
PUBLIC_BASE_URL=http://127.0.0.1:9000
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=52428800
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:8002","http://127.0.0.1:8002"]
DB_AUTO_MIGRATE=true

# ---- B6 自定义域名（Host → 租户）----
# 租户子域后缀：<slug>.<TENANT_BASE_DOMAIN>；留空表示不自动建子域。
TENANT_BASE_DOMAIN=
# 平台控制台自己的域名：命中它时不做租户解析。
PLATFORM_HOST=
# 域名所有权 TXT 校验的解析器：none（默认，verify 返回 503）/ dns（已内置 dnspython，线上用这个）
DOMAIN_VERIFY_PROVIDER=none
# 线上必须 false：否则不认识的域名会被静默当成 demo 站。本地开发可 true。
TENANT_HOST_FALLBACK=true
