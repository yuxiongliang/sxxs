# ============================================================
# 本项目在模板基础上的补充忽略规则（仓库不发布密钥/隐私数据）
# ============================================================

# --- 环境变量与密钥 ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
*.pem
*.key
*.p12
*.pfx

# --- Python 虚拟环境与缓存 ---
backend/.venv
.venv
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# --- 用户上传的附件（可能含个人隐私） ---
backend/uploads/
uploads/

# --- 上游模板 git 历史的本地备份（不发布） ---
.git-upstream-backup/

